{
  "name": "codex-motion-design",
  "version": "1.0.0",
  "private": true,
  "description": "Code-first motion design for Codex and ChatGPT: pure time, image-based critique and local export.",
  "license": "MIT",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "studio": "node scripts/serve.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "sheet": "node scripts/render.mjs --sheet --out=out/sheet.png",
    "draft": "node scripts/render.mjs --draft --out=out/draft.mp4",
    "render": "node scripts/render.mjs --out=out/signal.mp4",
    "audio": "node scripts/audio.mjs",
    "verify": "node scripts/verify.mjs",
    "rea:investigate": "node scripts/rea-case.mjs --phase=investigate",
    "rea:compare": "node scripts/rea-case.mjs --phase=compare",
    "rea:render": "node scripts/rea-case.mjs --phase=render",
    "rea:case": "node scripts/rea-case.mjs --phase=all",
    "core:verify": "node scripts/core-verify.mjs",
    "core:sheet": "node scripts/render.mjs --html=/examples/core-demo/index.html?capture=1 --project=examples/core-demo/project.json --sheet --out=out/core-sheet.png",
    "core:draft": "node scripts/render.mjs --html=/examples/core-demo/index.html?capture=1 --project=examples/core-demo/project.json --draft --out=out/core-draft.mp4",
    "core:render": "node scripts/render.mjs --html=/examples/core-demo/index.html?capture=1 --project=examples/core-demo/project.json --out=out/core-film.mp4",
    "core:audio": "node scripts/audio.mjs --project=examples/core-demo/project.json --out=out/core-audio.wav"
  },
  "devDependencies": {"playwright": "1.64.1"}
}
